#!/bin/bash

# Color definitions
cjamun='\033[0;35m'    
cparrot='\033[1;32m' 
cgreen='\033[0;32m'
cblack='\033[0;30m'
cred='\033[0;31m'
cskyblue='\033[1;36m'
cpink='\033[1;35m'
cblue='\033[1;34m'
credlight='\033[1;31m'
cmagenta='\033[0;35m'
creset='\033[0m'

pprint() {
    color=$1
    shift
    printf "${color}%b${creset}" "$*"
}

color_reset() { 
    printf "${creset}"; 
}

yesnoprompt() {
    old_stty_cfg=$(stty -g)
    stty raw -echo
    answer=$(head -c 1)
    stty $old_stty_cfg
    echo "$answer" | grep -iq "^y"
}

BADMUSIC_HEADER() {
    echo -e "${cskyblue}  ____          _____  __  __ _    _  _____ _____ _____ "
    echo -e "${cskyblue} |  _ \   /\   |  __ \|  \/  | |  | |/ ____|_   _/ ____|"
    echo -e "${cpink} | |_) | /  \  | |  | | \  / | |  | | (___   | || |     "
    echo -e "${cskyblue} |  _ < / /\ \ | |  | | |\/| | |  | |\___ \  | || |     "
    echo -e "${cpink} | |_) / ____ \| |__| | |  | | |__| |____) |_| || |____ "
    echo -e "${cskyblue} |____/_/    \_\_____/|_|  |_|\____/|_____/|_____\_____|${creset}"
}

# Clear screen and show header
clear
BADMUSIC_HEADER

pprint "${cparrot}" "\nWelcome to BADMUSIC Installer!\n"
pprint "${cblue}" "If you see any error during Installation Process, Please refer to these files for logs:\n"
pprint "${cjamun}"   "For node js errors , Checkout nodelog.txt\n"
pprint "${credlight}" "For pypi packages errors , Checkout pypilog.txt\n"
sleep 2

# Check for sudo privileges
pprint "${cgreen}" "Script needs sudo privileges in order to update & install packages.\n"
if ! sudo test &>/dev/null; then
    pprint "${cred}" "Sudo privileges not available. Please run as sudo or fix permissions.\n"
    exit 1
fi
pprint "${cgreen}" "Sudo check passed.\n"
sleep 1

update() {
    pprint "${cjamun}" "\nUpdating package list.. "
    if sudo apt update &>/dev/null; then
        pprint "${cgreen}" "DONE\n"
    else
        pprint "${cred}" "FAILED\n"
        exit 1
    fi

    # Check for upgrades
    if sudo apt list --upgradable &>/dev/null | grep -q "done"; then
        pprint "${cgreen}" "No updates available.\n"
    else
        pprint "${cgreen}" "UPDATES AVAILABLE\n"
        pprint "${cparrot}" "Do you want to automatically upgrade (y/n)? "
        if yesnoprompt; then
            pprint "${cjamun}" "Upgrading packages.. "
            if sudo apt upgrade -y &>/dev/null; then
                pprint "${cgreen}" "DONE!\n"
            else
                pprint "${cred}" "FAILED!\n"
                exit 1
            fi
        else
            pprint "${cgreen}" "Skipping upgrades.\n"
        fi
    fi
}

packages() {
    # Install pip if not present
    if ! command -v pip3 &>/dev/null; then
        pprint "${cparrot}" "Couldn't find pip3, installing now..."
        if sudo apt install python3-pip -y &>>pypilog.txt 2>&1; then
            pprint "${cgreen}" "SUCCESS.\n"
        else
            pprint "${cred}" "FAILED. Check pypilog.txt.\n"
            exit 1
        fi
    fi

    # Install ffmpeg if not present
    if ! command -v ffmpeg &>/dev/null; then
        pprint "${cparrot}" "Couldn't find ffmpeg, installing now..."
        if sudo apt install ffmpeg -y &>/dev/null; then
            pprint "${cgreen}" "SUCCESS.\n"
        else
            pprint "${cred}" "FAILED.\n"
            pprint "${cred}" "You need to install ffmpeg manually in order to deploy BADMUSIC, exiting...\n"
            exit 1
        fi
    fi

    # Check ffmpeg version and warn if <4
    fv=$(ffmpeg -version 2>/dev/null | grep -Po 'version (3\.[0-9]+)' | head -1)
    if [[ "$fv" =~ ^3\..* ]]; then
        pprint "${cjamun}" "⚠️  Playing live streams may not work with ffmpeg $fv. Live streams require version 4+.\n"
    fi
}

node() {
    if command -v npm &>/dev/null; then
        return
    fi
    pprint "${cmagenta}" "Installing Node.js and NPM.. "
    if curl -fssL https://deb.nodesource.com/setup_20.x | sudo -E bash - &>>nodelog.txt && \
       sudo apt install -y nodejs &>>nodelog.txt && \
       sudo npm install -g npm &>>nodelog.txt; then
        pprint "${cgreen}" "SUCCESS!\n"
    else
        pprint "${cred}" "FAILED. Check nodelog.txt.\n"
        exit 1
    fi
}

installation() {
    pprint "${cparrot}" "\nUpgrading pip and installing dependency packages..."
    if pip3 install -U pip &>>pypilog.txt && \
       pip3 install -U -r requirements.txt &>>pypilog.txt; then
        pprint "${cgreen}" "DONE.\n"
    else
        pprint "${cred}" "FAILED. Check pypilog.txt.\n"
        exit 1
    fi
}

# Run setup steps
update
packages
node
installation

pprint "${cgreen}" "\n\n🎉 BADMUSIC Installation Completed!\n"
sleep 2
clear

BADMUSIC_HEADER

# Prompt for environment variables
pprint "${cparrot}"   "Enter API ID: "; color_reset; read -r api_id
pprint "${cpink}"     "Enter API HASH: "; color_reset; read -r api_hash
pprint "${cskyblue}"  "Enter BOT TOKEN: "; color_reset; read -r bot_token
pprint "${cblack}"    "Enter OWNER ID: "; color_reset; read -r ownid
pprint "${cred}"      "Enter MONGO DB URI: "; color_reset; read -r mongo_db
pprint "${cblue}"     "Enter LOG GROUP ID: "; color_reset; read -r logger
pprint "${cmagenta}"  "Enter STRING SESSION (SESSION1): "; color_reset; read -r string_session

pprint "${cgreen}" "\n\nProcessing your vars, wait a while!"

# Remove existing .env if present
if [ -f .env ]; then
    rm .env
fi

# Create .env file with vars
cat > .env << EOF
API_ID=$api_id
API_HASH=$api_hash
BOT_TOKEN=$bot_token
MONGO_URL=$mongo_db
LOGGER_ID=$logger
OWNER_ID=$ownid
SESSION=$string_session
EOF

clear

pprint "${cpink}" "\n\n✅ Thanks for using BADMUSIC installer! Your vars have been saved successfully to .env\n"
pprint "${cjamun}" "💡 If you want to add more variables (e.g., API_URL, COOKIES_URL), edit .env with: vi .env or nano .env\n"
pprint "${cparrot}" "🚀 Now you can start the bot by: bash start\n\n"
pprint "${cgreen}" "Happy Music-ing! 🎵\n"
