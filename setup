#!/bin/bash

# Color definitions
cjamun='\033[0;35m'    
cparrot='\033[1;32m' 
cgreen='\033[0;32m'
cblack='\033[0;30m'
cred='\033[0;31m'
cskyblue='\033[1;36m'
cpink='\033[1;35m'
cblue='\033[1;34m'
credlight='\033[1;31m'
cmagenta='\033[0;35m'
cyellow='\033[1;33m'
creset='\033[0m'

sc_welcome="ᴡᴇʟᴄᴏᴍᴇ"
sc_installer="ɪɴsᴛᴀʟʟᴇʀ"
sc_api_id="ᴀᴘɪ ɪᴅ"
sc_api_hash="ᴀᴘɪ ʜᴀsʜ"
sc_bot_token="ʙᴏᴛ ᴛᴏᴋᴇɴ"
sc_owner_id="ᴏᴡɴᴇʀ ɪᴅ"
sc_mongo_db="ᴍᴏɴɢᴏ ᴅʙ ᴜʀɪ"
sc_log_group="ʟᴏɢ ɢʀᴏᴜᴘ ɪᴅ"
sc_string_session="sᴛʀɪɴɢ sᴇssɪᴏɴ"
sc_processing="ᴘʀᴏᴄᴇssɪɴɢ"
sc_thanks="ᴛʜᴀɴᴋs"
sc_start_bot="sᴛᴀʀᴛ ʙᴏᴛ"
sc_update="ᴜᴘᴅᴀᴛᴇ"
sc_packages="ᴘᴀᴄᴋᴀɢᴇs"
sc_node="ɴᴏᴅᴇ"
sc_installation="ɪɴsᴛᴀʟʟᴀᴛɪᴏɴ"
sc_completed="ᴄᴏᴍᴘʟᴇᴛᴇᴅ"
sc_configure="ᴄᴏɴғɪɢᴜʀᴇ"
sc_optional="ᴏᴘᴛɪᴏɴᴀʟ"
sc_vars="ᴠᴀʀs"
sc_wait="ᴡᴀɪᴛ"
sc_saved="sᴀᴠᴇᴅ"
sc_happy="ʜᴀᴘᴘʏ"
sc_streaming="sᴛʀᴇᴀᴍɪɴɢ"

pprint() {
    color=$1
    shift
    printf "${color}%b${creset}" "$*"
}

color_reset() { 
    printf "${creset}"; 
}

yesnoprompt() {
    old_stty_cfg=$(stty -g)
    stty raw -echo 
    answer=$(head -c 1)
    stty $old_stty_cfg
    echo "$answer" | grep -iq "^y"
}

# Animated header function with small caps
BADMUSIC_HEADER() {
    clear
    echo -e "${cskyblue}                                                 "
    echo -e "${cskyblue}  ____          _____  __  __ _    _  _____ _____ _____ "
    echo -e "${cpink} |  _ \   /\   |  __ \|  \/  | |  | |/ ____|_   _/ ____|"
    echo -e "${cskyblue} | |_) | /  \  | |  | | \  / | |  | | (___   | || |     "
    echo -e "${cpink} |  _ < / /\ \ | |  | | |\/| | |  | |\___ \  | || |     "
    echo -e "${cskyblue} | |_) / ____ \| |__| | |  | | |__| |____) |_| || |____ "
    echo -e "${cpink} |____/_/    \_\_____/|_|  |_|\____/|_____/|_____\_____|${creset}"
    echo -e "${cyellow}                                                 "
    echo -e "${cyellow}                  🔥 ${sc_installer^^} 🔥${creset}\n"
}

# Spinner for loading
spinner() {
    local pid=$!
    local delay=0.1
    local spinstr='|/-\'
    while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

clear
BADMUSIC_HEADER

pprint "${cparrot}" "${sc_welcome^^} ᴛᴏ ʙᴀᴅᴍᴜsɪᴄ ${sc_installer^^}! 🚀\n"
pprint "${cblue}" "ɪғ ʏᴏᴜ sᴇᴇ ᴀɴʏ ᴇʀʀᴏʀ ᴅᴜʀɪɴɢ ɪɴsᴛᴀʟʟᴀᴛɪᴏɴ ᴘʀᴏᴄᴇss, ᴘʟᴇᴀsᴇ ʀᴇғᴇʀ ᴛᴏ ᴛʜᴇsᴇ ғɪʟᴇs ғᴏʀ ʟᴏɢs:\n"
pprint "${cjamun}"   "📝 ғᴏʀ ɴᴏᴅᴇ js ᴇʀʀᴏʀs, ᴄʜᴇᴄᴋᴏᴜᴛ ɴᴏᴅᴇʟᴏɢ.ᴛxᴛ\n"
pprint "${credlight}" "📝 ғᴏʀ ᴘʏᴘɪ ᴘᴀᴄᴋᴀɢᴇs ᴇʀʀᴏʀs, ᴄʜᴇᴄᴋᴏᴜᴛ ᴘʏᴘɪʟᴏɢ.ᴛxᴛ\n"
sleep 2

pprint "${cgreen}" "sᴄʀɪᴘᴛ ɴᴇᴇᴅs sᴜᴅᴏ ᴘʀɪᴠɪʟᴇɢᴇs ɪɴ ᴏʀᴅᴇʀ ᴛᴏ ${sc_update^^} & ɪɴsᴛᴀʟʟ ᴘᴀᴄᴋᴀɢᴇs.\n"
sudo test &>/dev/null || { pprint "${cred}" "❌ sᴜᴅᴏ ᴀᴄᴄᴇss ᴅᴇɴɪᴇᴅ. ᴇxɪᴛɪɴɢ...\n"; exit 1; }

update() {
    pprint "${cyellow}" "🔄 ${sc_update^^}.. " && spinner
    sudo apt update -qq 2>&1 | grep "can be upgraded" &>/dev/null
    if [ $? -eq 0 ]; then
        pprint "${cgreen}" "✅ ${sc_update^^} ᴀᴠᴀɪʟᴀʙʟᴇ\n"
        pprint "${cparrot}" "ᴅᴏ ʏᴏᴜ ᴡᴀɴᴛ ᴛᴏ ᴀᴜᴛᴏᴍᴀᴛɪᴄᴀʟʟʏ ${sc_update^^} ᴘᴀᴄᴋᴀɢᴇs? (ʏ/ɴ): "
        if yesnoprompt; then
            pprint "${cyellow}" "🔄 ${sc_update^^} ᴘᴀᴄᴋᴀɢᴇs.. " && spinner
            if sudo apt upgrade -y -qq &>/dev/null; then
                pprint "${cgreen}" "✅ ᴅᴏɴᴇ!\n"
            else
                pprint "${cred}" "❌ ${sc_update^^} ғᴀɪʟᴇᴅ!\n"
                exit 1
            fi
        else
            echo -e "\n${cblue}sᴋɪᴘᴘɪɴɢ ${sc_update^^}s. ᴘʀᴏᴄᴇᴇᴅ ᴡɪᴛʜ ᴄᴀᴜᴛɪᴏɴ! ⚠️\n"
        fi
    else
        pprint "${cgreen}" "✅ ᴀʟʀᴇᴀᴅʏ ᴜᴘ ᴛᴏ ᴅᴀᴛᴇ\n"
    fi
}

packages() {
    if ! command -v pip &>/dev/null; then
        pprint "${cyellow}" "🔄 ɪɴsᴛᴀʟʟɪɴɢ ᴘɪᴘ..." && spinner
        if sudo apt install python3-pip -y -qq 2>>pypilog.txt; then
            pprint "${cgreen}" "✅ sᴜᴄᴄᴇss.\n"
        else
            pprint "${cred}" "❌ ғᴀɪʟᴇᴅ. ᴄʜᴇᴄᴋ ᴘʏᴘɪʟᴏɢ.ᴛxᴛ\n"
            exit 1
        fi
    fi

    if ! command -v ffmpeg &>/dev/null; then
        pprint "${cyellow}" "🔄 ɪɴsᴛᴀʟʟɪɴɢ ғғᴍᴘᴇɢ..." && spinner
        if sudo apt install ffmpeg -y -qq &>/dev/null; then
            pprint "${cgreen}" "✅ sᴜᴄᴄᴇss.\n"
        else
            pprint "${cred}" "❌ ғᴀɪʟᴇᴅ.\n"
            pprint "${credlight}" "ʏᴏᴜ ɴᴇᴇᴅ ᴛᴏ ɪɴsᴛᴀʟʟ ғғᴍᴘᴇɢ ᴍᴀɴᴜᴀʟʟʏ ᴛᴏ ᴅᴇᴘʟᴏʏ ʙᴀᴅᴍᴜsɪᴄ. ᴇxɪᴛɪɴɢ...\n"
            exit 1
        fi
    fi

    # Check ffmpeg version and warn if necessary
    fv=$(ffmpeg -version 2>&1 | grep -Po 'version (3\.[0-9]+)' | head -1)
    if [[ "$fv" == "version 3."* ]]; then
        pprint "${credlight}" "⚠️  ᴘʟᴀʏɪɴɢ ʟɪᴠᴇ sᴛʀᴇᴀᴍs ᴍᴀʏ ɴᴏᴛ ᴡᴏʀᴋ ᴡɪᴛʜ ғғᴍᴘᴇɢ $fv (ʀᴇQᴜɪʀᴇs 4+).\n"
    fi
}

node() {
    if command -v npm &>/dev/null; then
        return
    fi
    pprint "${cyellow}" "🔄 ɪɴsᴛᴀʟʟɪɴɢ ɴᴏᴅᴇ.js ʟᴛs ᴀɴᴅ ɴᴘᴍ..." && spinner
    if curl -fssL https://deb.nodesource.com/setup_lts.x | sudo -E bash - &>>nodelog.txt &&
       sudo apt install -y nodejs &>>nodelog.txt &&
       sudo npm i -g npm &>>nodelog.txt; then
        pprint "${cgreen}" "✅ sᴜᴄᴄᴇss!\n"
    else
        pprint "${cred}" "❌ ғᴀɪʟᴇᴅ. ᴄʜᴇᴄᴋ ɴᴏᴅᴇʟᴏɢ.ᴛxᴛ\n"
        exit 1
    fi
}

installation() {
    pprint "${cyellow}" "🔄 ᴜᴘɢʀᴀᴅɪɴɢ ᴘɪᴘ ᴀɴᴅ ɪɴsᴛᴀʟʟɪɴɢ ᴅᴇᴘᴇɴᴅᴇɴᴄʏ ᴘᴀᴄᴋᴀɢᴇs..." && spinner
    if pip3 install -U pip &>>pypilog.txt &&
       pip3 install -U -r requirements.txt &>>pypilog.txt; then
        pprint "${cgreen}" "✅ ᴅᴏɴᴇ.\n"
    else
        pprint "${cred}" "❌ ғᴀɪʟᴇᴅ. ᴄʜᴇᴄᴋ ᴘʏᴘɪʟᴏɢ.ᴛxᴛ\n"
        exit 1
    fi
}

# Run installations
pprint "${cparrot}" "\n🚀 sᴛᴀʀᴛɪɴɢ ${sc_installation^^}...\n"
update
packages
node
installation

pprint "${cgreen}" "\n🎉 ʙᴀᴅᴍᴜsɪᴄ ${sc_completed^^} sᴜᴄᴄᴇssғᴜʟʟʏ!\n"
sleep 2

# Config input section
BADMUSIC_HEADER
pprint "${cparrot}" "ɴᴏᴡ, ʟᴇᴛ's ${sc_configure^^} ʏᴏᴜʀ ʙᴏᴛ! 📝\n\n"

pprint "${cskyblue}" "🔑 ${sc_api_id^^}: "; color_reset; read -r api_id
pprint "${cpink}"     "🔑 ${sc_api_hash^^}: "; color_reset; read -r api_hash
pprint "${cblue}"     "🤖 ${sc_bot_token^^}: "; color_reset; read -r bot_token
pprint "${cblack}"    "👑 ${sc_owner_id^^}: "; color_reset; read -r ownid
pprint "${cred}"      "🗄️  ${sc_mongo_db^^}: "; color_reset; read -r mongo_db
pprint "${cmagenta}"  "📊 ${sc_log_group^^}: "; color_reset; read -r logger
pprint "${cyellow}"   "🔗 ${sc_string_session^^}: "; color_reset; read -r string_session

# Optional vars prompt
pprint "${cparrot}" "\n💡 ᴅᴏ ʏᴏᴜ ᴡᴀɴᴛ ᴛᴏ ᴀᴅᴅ ${sc_optional^^} ${sc_vars^^} ʟɪᴋᴇ ᴀᴘɪ_ᴜʀʟ, ᴄᴏᴏᴋɪᴇs_ᴇɴᴀʙʟᴇᴅ ᴇᴛᴄ.? (ʏ/ɴ): "
if yesnoprompt; then
    pprint "${cblue}" "🌐 ᴀᴘɪ ᴜʀʟ (ᴅᴇғᴀᴜʟᴛ: ʜᴛᴛᴘ://47.129.201.23:2020/ᴛʀʏ): "; color_reset; read -r api_url
    api_url=${api_url:-"http://47.129.201.23:2020/try"}
    pprint "${cjamun}" "🍪 ᴄᴏᴏᴋɪᴇs_ᴇɴᴀʙʟᴇᴅ (ᴛʀᴜᴇ/ғᴀʟsᴇ, ᴅᴇғᴀᴜʟᴛ: ғᴀʟsᴇ): "; color_reset; read -r cookies_enabled
    cookies_enabled=${cookies_enabled:-"False"}
    # Add more if needed
else
    api_url="http://47.129.201.23:2020/try"
    cookies_enabled="False"
fi

pprint "${cyellow}" "\n⏳ ${sc_processing^^} ʏᴏᴜʀ ${sc_vars^^}, ${sc_wait^^} ᴀ ᴡʜɪʟᴇ! " && spinner

# Backup existing .env if exists
if [ -f .env ]; then
    cp .env .env.backup
    pprint "${cblue}" "📁 ʙᴀᴄᴋᴜᴘ ᴏғ ᴇxɪsᴛɪɴɢ .ᴇɴᴠ ᴄʀᴇᴀᴛᴇᴅ ᴀs .ᴇɴᴠ.ʙᴀᴄᴋᴜᴘ\n"
fi

# Create .env
cat > .env << EOF
API_ID = $api_id
API_HASH = $api_hash
BOT_TOKEN = $bot_token
MONGO_URL = $mongo_db
LOGGER_ID = $logger
SESSION = $string_session
OWNER_ID = $ownid
API_URL = $api_url
API_ENABLED = True
COOKIES_ENABLED = $cookies_enabled
EOF

clear
BADMUSIC_HEADER

pprint "${cpink}" "✨ ${sc_thanks^^} ғᴏʀ ᴜsɪɴɢ ʙᴀᴅᴍᴜsɪᴄ ${sc_installer^^}! ʏᴏᴜʀ ${sc_vars^^} ʜᴀᴠᴇ ʙᴇᴇɴ ${sc_saved^^} sᴜᴄᴄᴇssғᴜʟʟʏ! 🎊\n"
pprint "${cblue}" "📝 ɪғ ʏᴏᴜ ᴡᴀɴɴᴀ ᴀᴅᴅ/ᴇᴅɪᴛ ᴍᴏʀᴇ ${sc_vars^^}, ᴀᴅᴅ ᴛʜᴇᴍ ɪɴ ʏᴏᴜʀ ᴇɴᴠ ʙʏ : ᴠɪ .ᴇɴᴠ\n"
pprint "${cgreen}" "🚀 ɴᴏᴡ ʏᴏᴜ ᴄᴀɴ ${sc_start_bot^^} ᴛʜᴇ ʙᴏᴛ ʙʏ : ʙᴀsʜ sᴛᴀʀᴛ\n\n"
pprint "${cyellow}" "${sc_happy^^} ${sc_streaming^^}! 🎵🔥\n"
